<%- include('partials/header', { title: 'כרטיס לקוח' }) %>

<style>
  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .vfield { background: #f8f9fb; border-radius: 6px; padding: 10px 12px; }
  .vfield .k { font-size: 12px; color: #777; margin-bottom: 2px; }
  .vfield .v { font-size: 16px; font-weight: bold; }
</style>

<h1>
  <%= customer.first_name || '' %> <%= customer.last_name || '' %>
  <% if (customer.needs_details) { %><span class="badge-pending">(להשלמת פרטים)</span><% } %>
  <% if (customer.blocked) { %><span class="badge-pending" style="background:#f8d7da; color:#842029;">(חסום מהזמנות)</span><% } %>
</h1>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<p>
  <a href="/admin/customers/<%= customer.id %>/edit">✎ עריכה</a> |
  <a href="/admin/customers/<%= customer.id %>/history">היסטוריית שיחות והזמנות</a>
  <% if (customer.name_recording_path) { %> | <a href="/admin/recording/<%= customer.id %>" target="_blank">🔊 הקלטת שם</a><% } %>
</p>

<div class="card">
  <div class="vgrid">
    <div class="vfield"><div class="k">קוד לקוח</div><div class="v"><%= customer.code || customer.id %></div></div>
    <div class="vfield"><div class="k">בן (שם האב)</div><div class="v"><%= customer.father_name || '-' %></div></div>
    <div class="vfield"><div class="k">מספר זהות</div><div class="v"><%= customer.id_number || '-' %></div></div>
    <div class="vfield"><div class="k">עיר</div><div class="v"><%= customer.city || '-' %></div></div>
    <div class="vfield"><div class="k">שכונה</div><div class="v"><%= customer.neighborhood || '-' %></div></div>
    <div class="vfield"><div class="k">כתובת</div><div class="v"><%= customer.address || '-' %> <%= customer.house_number || '' %></div></div>
    <div class="vfield"><div class="k">טלפון</div><div class="v"><%= customer.phone || '-' %></div></div>
    <div class="vfield"><div class="k">פלאפון בעל</div><div class="v"><%= customer.husband_mobile || '-' %></div></div>
    <div class="vfield"><div class="k">פלאפון אישה</div><div class="v"><%= customer.wife_mobile || '-' %></div></div>
    <div class="vfield"><div class="k">פלאפון נוסף</div><div class="v"><%= customer.extra_mobile || '-' %></div></div>
    <div class="vfield"><div class="k">נרשם בתאריך</div><div class="v"><%= customer.created_at %></div></div>
    <div class="vfield" style="background:<%= balance > 0 ? '#e8f8ee' : '#f8f9fb' %>;"><div class="k">יתרת זכות</div><div class="v"><%= balance %> ש"ח</div></div>
    <div class="vfield"><div class="k">4 ספרות אחרונות בכרטיס</div><div class="v"><%= customer.card_last4 || '-' %></div></div>
  </div>
</div>

<% if (typeof currentRole !== 'undefined' && currentRole === 'manager') { %>
<div class="card">
  <h3>חסימת לקוח</h3>
  <p style="color:#777; font-size:13px;">לקוח חסום לא יוכל להירשם למיטות חדשות בטלפון (שלוחת הרשמה), אך עדיין יוכל להתקשר לבירור ותשלום על הזמנות קיימות.</p>
  <form method="post" action="/admin/customers/<%= customer.id %>/toggle-block">
    <button type="submit"><%= customer.blocked ? 'בטל חסימה' : 'חסום לקוח' %></button>
  </form>
</div>

<div class="card">
  <h3>עדכון יתרת זכות ידני</h3>
  <p style="color:#777; font-size:13px;">סכום חיובי = הוספת זכות, סכום שלילי = ניכוי זכות</p>
  <form method="post" action="/admin/customers/<%= customer.id %>/credit">
    <input type="number" step="0.5" name="amount" placeholder="סכום" required style="width:120px">
    <input type="text" name="reason" placeholder="סיבה (אופציונלי)" style="width:220px">
    <button type="submit">עדכן זכות</button>
  </form>
</div>
<% } %>

<div class="card">
  <h3>הוספת הזמנת מיטות ידנית</h3>
  <form method="post" action="/admin/customers/<%= customer.id %>/reservations">
    <label>חג / מקום</label>
    <select name="capacity_id" id="capacity-select" required onchange="document.getElementById('price-input').value = this.selectedOptions[0].dataset.price || ''">
      <option value="">-- בחר --</option>
      <% bookableOptions.forEach(function(o) { %>
      <option value="<%= o.capacity_id %>" data-price="<%= o.price_per_bed %>">
        <%= o.holiday_name %> <%= o.year_label %> - <%= o.location_name %> (פנויות: <%= o.available_beds %>, מחיר: <%= o.price_per_bed %>)
      </option>
      <% }) %>
    </select>
    <label>כמות מיטות</label>
    <input type="number" min="1" name="bed_count" required style="width:80px">
    <label>מחיר למיטה (מתמלא אוטומטית לפי המקום שנבחר, ניתן לשנות)</label>
    <input type="number" step="0.5" name="price" id="price-input" style="width:80px">
    <p><label style="display:inline; font-weight:normal;"><input type="checkbox" name="mark_paid" style="width:auto"> שולם כבר (מזומן/צ'ק)</label></p>
    <p style="color:#777; font-size:13px;">אם לא מסמנים "שולם כבר", וללקוח יש יתרת זכות זמינה - היא תקוזז אוטומטית וההזמנה תסומן כשולמה על ידה (במלואה או בחלקה).</p>
    <button type="submit">הוסף הזמנה</button>
  </form>
</div>

<a href="/admin/customers">חזרה לרשימה</a>

<%- include('partials/footer') %>
