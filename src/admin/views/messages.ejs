<%- include('partials/header', { title: 'הודעות', wide: true }) %>

<h1>הודעות שהושארו</h1>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div style="display:flex; gap:16px; align-items:flex-start;">
  <div class="card" style="flex:0 0 260px; padding:0; max-height:75vh; overflow-y:auto;">
    <% if (threads.length === 0) { %>
    <p style="padding:12px;">אין הודעות</p>
    <% } %>
    <% threads.forEach(function(t) { %>
    <a href="/admin/messages?thread=<%= t.threadId %>"
       style="display:block; padding:10px 12px; text-decoration:none; color:inherit; border-bottom:1px solid #eee; <%= selected && selected.threadId === t.threadId ? 'background:#eef1f6;' : '' %> <%= t.latest.handled ? 'opacity:0.55;' : '' %>">
      <div style="font-weight:bold;"><%= t.phone || 'מספר לא ידוע' %></div>
      <div style="font-size:11px; color:#777;"><%= t.latest.created_at %> · <%= t.messages.length %> הודעות<% if (t.latest.handled) { %> · טופל<% } %></div>
    </a>
    <% }) %>
  </div>

  <div style="flex:1; min-width:0;">
    <% if (!selected) { %>
    <div class="card"><p>בחר שיחה מהרשימה</p></div>
    <% } else { %>
    <div class="card" style="<%= selected.latest.handled ? 'opacity:0.8;' : '' %>">
      <h3><%= selected.phone || 'מספר לא ידוע' %></h3>

      <% selected.messages.forEach(function(m) { %>
      <div style="border-top:1px solid #eee; padding:8px 0;">
        <div style="font-size:12px; color:#777;"><%= m.created_at %></div>
        <% if (m.recording_path) { %>
        <audio controls src="/admin/messages/<%= m.id %>/recording" style="height:32px;"></audio>
        <a href="/admin/messages/<%= m.id %>/recording?download=1" style="margin-right:8px;">⬇ הורדה</a>
        <% } else { %><span>אין הקלטה</span><% } %>
        <% if (m.reply_text) { %>
        <div style="background:#eef1f6; border-radius:4px; padding:6px 10px; margin-top:6px;">
          <strong>התשובה שלך:</strong> <%= m.reply_text %>
          <span style="font-size:11px; color:#777;">(<%= m.reply_heard ? 'נשמעה על ידי הלקוח' : 'ממתינה שהלקוח יתקשר וישמע' %>)</span>
        </div>
        <% } %>
      </div>
      <% }) %>

      <form method="post" action="/admin/messages/<%= selected.latest.id %>/reply" style="margin-top:10px;">
        <textarea name="reply_text" rows="2" style="width:100%;" placeholder="כתוב תשובה ללקוח..."><%= selected.latest.reply_text || '' %></textarea>
        <button type="submit">שמור תשובה ושלח התראה ללקוח</button>
      </form>

      <p style="margin-top:10px;">
        <form method="post" action="/admin/messages/<%= selected.latest.id %>/toggle-handled" class="inline">
          <button type="submit" class="<%= selected.latest.handled ? '' : 'danger' %>"><%= selected.latest.handled ? '✔ טופל' : 'סמן כטופל' %></button>
        </form>
        <form method="post" action="/admin/messages/thread/<%= selected.threadId %>/delete" class="inline" onsubmit="return confirm('למחוק את כל השיחה הזו?')">
          <button type="submit" class="danger">מחק שיחה</button>
        </form>
      </p>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
