<%- include('partials/header', { title: 'עריכת מחזור' }) %>

<h1>עריכת מחזור: <%= season.holiday_name %> - <%= season.year_label %></h1>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="card">
  <form method="post" action="/admin/seasons/<%= season.id %>">
    <label>פתוח מתאריך ושעה (אפשר להשאיר ריק)</label>
    <input type="datetime-local" name="opens_at" value="<%= season.opens_at_local || '' %>">
    <label>פתוח עד תאריך ושעה (למשל, כדי לסגור את ההרשמה בשעה 10 בבוקר)</label>
    <input type="datetime-local" name="closes_at" value="<%= season.closes_at_local || '' %>">

    <h3>מקומות רלוונטים לחג זה</h3>
    <table>
      <tr><th>רלוונטי?</th><th>מקום</th><th>סה"כ מיטות</th><th>מחיר למיטה</th><th>מיטות שנרשמו כבר</th></tr>
      <% locations.forEach(function(loc) { %>
      <tr>
        <td><input type="checkbox" name="loc_<%= loc.id %>_active" <%= loc.active ? 'checked' : '' %>></td>
        <td><%= loc.name %></td>
        <td><input type="number" min="0" name="loc_<%= loc.id %>_total" value="<%= loc.total_beds || 0 %>" style="width:80px"></td>
        <td><input type="number" min="0" step="0.5" name="loc_<%= loc.id %>_price" value="<%= loc.price_per_bed || 50 %>" style="width:80px"></td>
        <td><%= loc.reserved_beds || 0 %></td>
      </tr>
      <% }) %>
    </table>

    <div style="margin-top:12px;"><button type="submit">שמור</button></div>
  </form>
</div>

<a href="/admin/holidays">חזרה לניהול חגים</a>

<%- include('partials/footer') %>
