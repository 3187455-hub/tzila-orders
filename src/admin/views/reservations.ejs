<%- include('partials/header', { title: 'הזמנות' }) %>

<h1>הזמנות ותשלומים</h1>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="card">
  <form method="get" action="/admin/reservations">
    <label>סינון לפי מחזור חג</label>
    <select name="season_id" onchange="this.form.submit()">
      <option value="">הכל</option>
      <% seasons.forEach(function(s) { %>
      <option value="<%= s.id %>" <%= String(s.id) === String(seasonId) ? 'selected' : '' %>><%= s.holiday_name %> - <%= s.year_label %></option>
      <% }) %>
    </select>
    <input type="text" name="q" placeholder="חיפוש לפי לקוח, חג, מקום" value="<%= q || '' %>" style="width:240px;">
    <button type="submit">חפש</button>
    <a href="/admin/reservations/export.csv?season_id=<%= seasonId || '' %>&q=<%= encodeURIComponent(q || '') %>" style="margin-right:12px;">⬇ ייצוא לאקסל (לפי הסינון הנוכחי)</a>
  </form>
</div>

<table>
  <tr>
    <th>לקוח</th><th>חג</th><th>מקום</th><th>מיטות</th><th>מחיר למיטה</th><th>סה"כ</th><th>סטטוס</th><th>פעולות</th>
  </tr>
  <% reservations.forEach(function(r) { %>
  <form id="count-<%= r.id %>" method="post" action="/admin/reservations/<%= r.id %>/count"></form>
  <form id="price-<%= r.id %>" method="post" action="/admin/reservations/<%= r.id %>/price"></form>
  <tr>
    <td><a href="/admin/customers/<%= r.customer_id %>"><%= r.first_name || '' %> <%= r.last_name || '' %></a> (<%= r.customer_code || r.customer_id %>)</td>
    <td><%= r.holiday_name %> <%= r.year_label %></td>
    <td><%= r.location_name %></td>
    <td>
      <input type="number" min="1" name="count" form="count-<%= r.id %>" value="<%= r.bed_count %>" style="width:60px">
      <button type="submit" form="count-<%= r.id %>">עדכן</button>
    </td>
    <td>
      <input type="number" step="0.5" name="price" form="price-<%= r.id %>" value="<%= r.price_per_bed_snapshot %>" style="width:70px">
      <button type="submit" form="price-<%= r.id %>">עדכן</button>
    </td>
    <td><%= r.bed_count * r.price_per_bed_snapshot %></td>
    <td class="<%= r.status === 'paid' ? 'badge-paid' : 'badge-pending' %>"><%= r.status === 'paid' ? 'שולם' : 'ממתין לתשלום' %></td>
    <td>
      <% if (r.status !== 'paid') { %>
      <form method="post" action="/admin/reservations/<%= r.id %>/mark-paid" class="inline">
        <button type="submit">סמן כשולם</button>
      </form>
      <% } else { %>
      <form method="post" action="/admin/reservations/<%= r.id %>/mark-unpaid" class="inline" onsubmit="return confirm('לבטל את סימון התשלום?')">
        <button type="submit">בטל תשלום</button>
      </form>
      <% } %>
      <form method="post" action="/admin/reservations/<%= r.id %>/cancel" class="inline" onsubmit="return confirm('למחוק את ההזמנה הזו?')">
        <button type="submit" class="danger">מחק</button>
      </form>
      <form method="post" action="/admin/reservations/<%= r.id %>/transfer" class="inline" onsubmit="return confirm('להעביר הזמנה זו ללקוח אחר?')">
        <input type="text" name="target_code" placeholder="קוד לקוח יעד" required style="width:90px">
        <% if (r.status === 'paid') { %>
        <select name="payment_handling">
          <option value="transfer">להעביר גם את התשלום</option>
          <option value="credit">להשאיר זכות אצל הלקוח הנוכחי, החדש ימתין לתשלום</option>
        </select>
        <% } %>
        <button type="submit">העבר</button>
      </form>
      <form method="post" action="/admin/reservations/<%= r.id %>/location" class="inline">
        <select name="location_id">
          <% (locationsBySeason[r.holiday_season_id] || []).forEach(function(loc) { %>
          <option value="<%= loc.location_id %>" <%= loc.location_id === r.location_id ? 'selected' : '' %>>
            <%= loc.location_name %> (פנויות: <%= loc.available_beds %>)
          </option>
          <% }) %>
        </select>
        <button type="submit">עדכן מקום</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table>

<%- include('partials/footer') %>
