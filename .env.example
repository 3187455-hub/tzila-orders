# ==============================================================
# קובץ הגדרות סודיות - העתק קובץ זה בשם ".env" ומלא את הערכים בפועל
# קובץ ה-".env" עצמו לא נכנס לגיט (שמור ב-.gitignore) כדי שהסודות
# לא ייחשפו לאף אחד.
# ==============================================================

# פורט שהשרת יאזין עליו (בדרך כלל אין צורך לשנות)
PORT=3000

# --- ימות המשיח ---
# מילת סוד שרירותית שאתה בוחר בעצמך (אותיות/מספרים, ללא רווחים).
# מוסיפים אותה גם בהגדרות ה-webhook בימות המשיח (api_add) כדי
# שהשרת יוכל לוודא שהבקשה באמת הגיעה מימות המשיח ולא מגורם זר.
YEMOT_SHARED_SECRET=

# טוקן ה-API הכללי של ימות המשיח, בפורמט "מספר_מערכת:סיסמת_API"
# (לדוגמה: 0771234567:1234) - מוגדר בממשק הניהול של ימות המשיח
# תחת הגדרות API. משמש למודול הקבצים (DownloadFile/UploadTextFile)
# לסנכרון טוקן האשראי בין מספרי הטלפון של אותו לקוח.
YEMOT_API_TOKEN=

# נתיב הקובץ ivr2:/... שבו שמור קובץ TokensByCreditCard בעץ השלוחות שלך
# (לדוגמה: /3/TokensByCreditCard)
YEMOT_TOKENS_FILE_PATH=

# --- נדרים פלוס ---
# מספר המוסד (טרמינל) שקיבלת מנדרים פלוס
NEDARIM_PLUS_TERMINAL_NUMBER=

# קוד אימות ה-API (ApiValid) שמקבלים מהתמיכה של נדרים פלוס
NEDARIM_PLUS_API_VALID=

# קטגוריה בנדרים פלוס שהעסקאות ישויכו אליה (לא חייבת להיות קיימת מראש -
# נדרים פלוס תיצור אותה אוטומטית אם היא חדשה)
NEDARIM_PLUS_CATEGORY=בצילא

# --- פאנל ניהול ---
# שם משתמש וסיסמה להתחברות לפאנל הניהול באינטרנט
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# מחרוזת אקראית וסודית לחתימת ה-session של הפאנל (אפשר להמציא
# מחרוזת ארוכה ואקראית כלשהי - לא צריך לזכור אותה)
SESSION_SECRET=
